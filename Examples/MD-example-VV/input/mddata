# file names for input files
COORDINATES start
SCALEDAT scale_RNA.dat
TOPOLOGY parameters.top
# output options
DUMPCOORDS 25
DUMPENERGY 25
DUMPPDB 250
RMSD 25 F
# simulation settings
MDMODE VV 
TEMPERATURE 0.616 
# time step in ps (use TIMEUNIT INTERNAL for units of 48.888 fs)
TIMESTEP 0.0005
MDSTEPS 2000
# initial minimisation
MININIT 5000 100 1.0D-3
# thermalisation
THERMALISATION 25 2000
THERMALISE_OPTIONS 5 0 1 50
